# LubanNav 语音网关环境变量示例。
# 用法：cp voice-gateway.env.example voice-gateway.env，填入真实值后
#       docker compose --profile voice up -d
# 密钥只存在于容器环境变量，绝不写入前端构建产物或仓库。

# 必填：北京地域、属于下方 Workspace 的永久百炼 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxx

# 必填：部署方的北京地域 Workspace ID
QWEN_WORKSPACE_ID=ws-xxxxxxxx

# 必填：演示访问码（与分享链接 ?accessCode=... 一致）
LUBANNAV_ACCESS_CODE=change-me

# 可选：5 分钟窗口内允许的会话交换次数
RATE_LIMIT_PER_WINDOW=30

# 可选：覆盖 ALLOWED_ORIGINS。局域网部署时必须包含站点 Origin，
# 例如 http://192.168.1.10:8080（多个用逗号分隔）。
# ALLOWED_ORIGINS=http://192.168.1.10:8080
