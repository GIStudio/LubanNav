[Unit]
Description=car7 RTK NMEA driver (auto serial port matching)
Documentation=file:///home/pc/campusCar/src/rtk_tools/rtk_nmea_start.sh
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=pc
# 启动前清理容器内残留驱动，避免多实例抢串口
ExecStartPre=-/usr/bin/docker exec campuscar-stm32-hoverboard bash -c 'pkill -9 -f "[n]mea_serial_driver" || true'
ExecStart=/usr/bin/docker exec campuscar-stm32-hoverboard bash -c 'source /opt/ros/humble/setup.bash && bash /workspace/campusCar-new-chassis/src/rtk_tools/rtk_nmea_start.sh'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
