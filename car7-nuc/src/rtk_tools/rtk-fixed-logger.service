[Unit]
Description=car7 RTK Fixed persistent logger (Fixed-only /fix -> JSONL, never truncates)
Documentation=file:///home/pc/campusCar/src/rtk_tools/README.md
After=network.target

[Service]
Type=simple
User=pc
WorkingDirectory=/home/pc/campusCar
ExecStart=/home/pc/campusCar/src/rtk_tools/rtk_fixed_logger_run.sh
Restart=on-failure
RestartSec=10
# 只记 status==4 (RTK_FIXED) 到 data/logs/rtk_fixed.jsonl（追加，跨启动保留）。
# 安装：sudo cp rtk-fixed-logger.service /etc/systemd/system/ && sudo systemctl enable --now rtk-fixed-logger

[Install]
WantedBy=multi-user.target
