[Unit]
Description=car7 automatic road-network builder (nearest-k graph from RTK Fixed log)
Documentation=file:///home/pc/campusCar/src/rtk_tools/README.md
After=rtk-fixed-logger.service
Wants=rtk-fixed-logger.service

[Service]
Type=simple
User=pc
WorkingDirectory=/home/pc/campusCar
ExecStart=/usr/bin/python3 /home/pc/campusCar/src/rtk_tools/roadnet_builder.py --watch
Restart=on-failure
RestartSec=3
# 增量读取 rtk_fixed.jsonl，每点关联最近 3 个点，原子写 data/maps/campus_road_network.json。
# 安装：sudo cp rtk-roadnet-builder.service /etc/systemd/system/ && sudo systemctl enable --now rtk-roadnet-builder

[Install]
WantedBy=multi-user.target
